# FileWizardIO — Environment Variables
# Bu dosyayı .env olarak kopyala ve gerçek değerleri doldur:
#   cp .env.example .env
# .env dosyasını ASLA git'e commit etme!

# JWT Secret — rastgele uzun bir string olmalı (min 32 karakter)
# Üretmek için: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=buraya-cok-uzun-rastgele-bir-string-yaz

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...

# Uygulama
APP_ENV=production
ALLOWED_ORIGINS=https://filewizardio.com
